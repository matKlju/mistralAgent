          {
            "id": "d920fc31-cba7-4cbf-8706-e941755eb5a6",
            "key": "result",
            "value": "${votingDetails.slice(0, 5).map((v, i) => (i + 1) + \". \" + (v.relatedDraft && v.relatedDraft.title ? v.relatedDraft.title.replace(/\"/g, \"\") : \"—\") + \" (Kohal: \" + v.present + \", Puudus: \" + v.absent + \", Poolt: \" + v.inFavor + \", Vastu: \" + v.against + \", Erapooletu: \" + v.neutral + \", Ei hääletanud: \" + v.abstained + \")\").join(\" \")}"
          }
